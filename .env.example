# Copy to .env (never commit .env). Every value is optional: with nothing set you get the free offline setup
# (stub brain, fake chat, drawn placeholder game if no browser is attached, recording to recordings/).
# Inline comments after "  #" are allowed. See docs/SETUP.md for what each group does.

# --- brain (LLM) ---
# Order: ANTHROPIC_API_KEY set -> Claude only. Otherwise Groq, then Gemini (ChainBrain), then the offline stub.
ANTHROPIC_API_KEY=            # optional, paid; empty = use the free chain below
HUBIE_MODEL=claude-haiku-5-5
GROQ_API_KEY=                 # free key from console.groq.com (first in the chain)
HUBIE_GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=               # free key from aistudio.google.com (backup)
HUBIE_GEMINI_MODEL=gemini-3.8-flash
HUBIE_LLM_EVENT_GAP=120       # free-tier budget: game/idle lines use the LLM at most once per N s (chat always does)
HUBIE_LLM_COOLDOWN=45         # a backend that failed (quota, timeout) rests this long, the next one takes over

# --- voice (edge-tts, free) ---
HUBIE_VOICE=en-US-AndrewNeural
HUBIE_VOICE_RATE=-12%
HUBIE_VOICE_PITCH=-6Hz

# --- look ---
HUBIE_LAYOUT=A                # A = Broadcast (big game, info strip, lower-third) | B = Lounge (big Hubie, speech bubble)

# --- output ---
HUBIE_RTMP_URL=               # rtmps://<kick ingest url>/<stream key>  (empty = record to recordings/)
HUBIE_RECORD_LIVE=0           # 1 = while live, also keep a local copy of the same encode in recordings/ (for the VOD)
HUBIE_SEGMENT_SECS=3600       # file mode: one .ts per hour (crash-safe, concat for the VOD)
HUBIE_VIDEO_BITRATE=2500k
HUBIE_X264_PRESET=veryfast
HUBIE_X264_THREADS=2
# HUBIE_STAGE_NICE (default -10) and HUBIE_PYTHON (default python3, e.g. .venv/bin/python) are read by
# ecosystem.config.js from the shell environment when you run `pm2 start`, not from this file.
HUBIE_MUSIC=                  # optional background loop (mp3/wav you have rights to), ducked under speech
HUBIE_MUSIC_DB=-26

# --- chat ---
HUBIE_CHAT_SOURCES=fake       # fake,kickhook,kick  (kickhook = official Kick API webhooks, recommended)
KICK_CLIENT_ID=               # Kick app (kick.com/settings/developer), webhooks enabled
KICK_CLIENT_SECRET=
KICK_WEBHOOK_PORT=8108        # local port; put HTTPS (nginx/caddy) in front, webhook path /kick/webhook
KICK_CHANNEL=                 # your channel slug
KICK_CHATROOM_ID=             # legacy public socket only: or give the chatroom id directly
KICK_PUSHER_KEY=              # legacy public socket only (key/cluster change; prefer kickhook)
KICK_PUSHER_HOST=ws-us2.pusher.com

# --- game ---
HUBIE_GAME=housebets          # housebets = real site, zero bets, operator's logged-in Chrome (placeholder if unavailable) | local = offline stand-in
HUBIE_HB_CDP=http://127.0.0.1:9241   # the logged-in Chrome's DevTools port (see docs/SETUP.md section 6)
HUBIE_HB_ROTATION=dice,plinko # adapters in games/: dice, plinko, mines (slot exists but needs WebGL)
HUBIE_HB_ROTATE_MIN=20        # minutes per game
HUBIE_HB_FPS=10               # game picture frames per second into the stage
HUBIE_VIEWER_URL=             # where the operator reaches the browser, shown in RUN/needs_owner.txt
HUBIE_ROUND_SECS=9            # local stand-in game only
HUBIE_GAME_FPS=4              # local stand-in game only
HUBIE_GAME_RECYCLE_MIN=120    # local stand-in game only

# --- pacing ---
HUBIE_IDLE_SECS=25            # idle commentary after this much silence
HUBIE_GAME_LINE_GAP=20
HUBIE_WIN_CLIP_GAP=30
HUBIE_LOSS_CLIP_GAP=60        # the "oh well" loss beat: at most once a minute
HUBIE_LOSS_CLIP_ROUNDS=4      # ... and at least this many rounds apart
HUBIE_CHAT_BACKLOG=12         # flood guard only: chat is answered in order, dropped after HUBIE_CHAT_MAX_AGE
HUBIE_CHAT_MAX_AGE=90
# turn-taking (what Hubie says matches the picture; see docs/ARCHITECTURE.md)
HUBIE_REACT_TTS_SECS=2.5      # edge-tts time for a reaction before a pre-voiced line is used
HUBIE_REACT_STALE=7           # a reaction must start within this many s of its result, else it is dropped
HUBIE_IDLE_STALE=8
HUBIE_TURN_REACT_WAIT=8       # game: longest wait for a reaction that has not started
HUBIE_TURN_REACT_MAX=20       # game: longest wait while the reaction is being spoken
HUBIE_TURN_TALK_MAX=30        # game: longest hold in a row while Hubie talks / answers chat
HUBIE_TURN_PAUSE=0.8
HUBIE_SWITCH_WAIT=8           # game: switch anyway if the "next up" line has not started by then
HUBIE_SWITCH_LEAD=1.2         # game: switch this long after the "next up" line started
HUBIE_CAPTION_HOLD=4          # stage: caption cleared this long after a line ends

# --- watchdog ---
HUBIE_WD_STALL=12             # stage restarted if the encoder frame counter stops for this many s
HUBIE_WD_GRACE=40             # after a (re)start, give a part this long to come up

# --- runtime ---
HUBIE_RUN_DIR=/dev/shm/hubie247
HUBIE_PM2_PREFIX=hubie247-
